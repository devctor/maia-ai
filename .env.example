# ------------------------------------------------------------------ database
# Host port 5434 avoids colliding with a local PostgreSQL already on 5432.
POSTGRES_PORT=5434
POSTGRES_USER=maia
POSTGRES_PASSWORD=maia
POSTGRES_DB=maia_care
DATABASE_URL=postgresql://maia:maia@localhost:5434/maia_care

# ------------------------------------------------------------------ api
API_PORT=3001
# Comma-separated list. The web app calls the API from the browser, so it must be explicit.
CORS_ORIGINS=http://localhost:3000
# There is no auth in this case: one demo user is seeded and addressed by this email.
DEMO_USER_EMAIL=ana@example.com

# ------------------------------------------------------------------ ai
# gemini | mock. `mock` is deterministic, offline and the default, so the project runs with no
# key and no network. `gemini` calls the real Google API and needs GEMINI_API_KEY.
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
AI_TIMEOUT_MS=20000
AI_MAX_ATTEMPTS=3
AI_RETRY_BASE_DELAY_MS=400

# ------------------------------------------------------------------ web
# Browser-side base URL: the insight stream is consumed by the browser.
NEXT_PUBLIC_API_URL=http://localhost:3001
